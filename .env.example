# Local use: SQLite default is automatic. Set this only when using PostgreSQL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/mitracare

# Local HTTP must use false. Set true behind HTTPS (Cloud Run).
COOKIE_SECURE=false

# Optional email delivery. Use a transactional SMTP provider and app-specific credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

LOG_LEVEL=INFO

# Optional AI Task Coach; only a fixed coordination category is sent to Gemini.
# Keep this key server-side and never expose it in static/app.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
